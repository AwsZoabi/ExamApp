NODE_ENV=development
SERVER_PORT=4000
DATA_SOURCE=postgres

# Host Node -> Docker PostgreSQL uses localhost:5432.
# Container Node -> Compose PostgreSQL should use postgres:5432.
DATABASE_URL=postgresql://examapp:examapp_dev_only@localhost:5432/examapp
DATABASE_SSL=disable
JSON_DB_PATH=./data/db.json
DB_CONNECT_RETRIES=15
DB_CONNECT_RETRY_MS=1000

# Replace before any real deployment (minimum 32 characters).
JWT_SECRET=replace-this-development-secret-with-32-plus-characters
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
ALLOW_TEACHER_REGISTRATION=false

CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
LOG_LEVEL=info
TRUST_PROXY=false
