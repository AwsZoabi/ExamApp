{
  "name": "examapp-final-server",
  "version": "1.0.0",
  "private": true,
  "description": "Secure ExamApp REST API with PostgreSQL and JSON repositories",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
