# Core stack
POSTGRES_DB=examapp
POSTGRES_USER=examapp
POSTGRES_PASSWORD=examapp_dev_only
POSTGRES_PORT=5432
SERVER_PORT=4000
CLIENT_PORT=8080

# Server storage: postgres or json
DATA_SOURCE=postgres
DATABASE_URL=postgresql://examapp:examapp_dev_only@postgres:5432/examapp
DATABASE_SSL=disable
JSON_DB_PATH=./data/db.json

# Authentication (replace locally; never commit a real secret)
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_EXPIRES_IN=8h
ALLOW_TEACHER_REGISTRATION=true

# Browser/API
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
VITE_API_URL=/api
VITE_DATA_SOURCE=api

# Optional published-image deployment
DOCKERHUB_USERNAME=your-dockerhub-user
IMAGE_TAG=latest

