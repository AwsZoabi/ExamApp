# Copy to .env.production on the deployment host. Never commit the real file.
DOCKERHUB_USERNAME=your-dockerhub-user
IMAGE_TAG=latest

POSTGRES_DB=examapp
POSTGRES_USER=examapp
POSTGRES_PASSWORD=replace-with-a-strong-database-password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
PUBLIC_CLIENT_ORIGIN=https://examapp.example.com
CLIENT_PORT=8080
