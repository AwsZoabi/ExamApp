# Vite development connects directly to the ExamApp API on the host.
VITE_API_URL=http://localhost:4000/api

# Use "api" for the Express/PostgreSQL backend or "mock" for the self-contained demo.
VITE_DATA_SOURCE=api

# Optional client request timeout in milliseconds.
VITE_REQUEST_TIMEOUT_MS=10000

# Use "hash" for static hosts such as GitHub Pages; keep "browser" for the API deployment.
VITE_ROUTER_MODE=browser
